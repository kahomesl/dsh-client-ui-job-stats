{
  "name": "dsh-client-ui-job-stats",
  "version": "1.4.2",
  "private": true,
  "description": "Session background-job statistics for DeepSeek Harness: a right Sidebar tab that accumulates every job the session ran (totals per status, success rate, duration, retained output, per-task detail), in Simplified Chinese and English.",
  "license": "MIT",
  "author": "kahomesl",
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "client-plugin",
    "background-jobs",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahomesl/dsh-client-ui-job-stats.git"
  },
  "homepage": "https://github.com/kahomesl/dsh-client-ui-job-stats#readme",
  "bugs": {
    "url": "https://github.com/kahomesl/dsh-client-ui-job-stats/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./recorder": "./lib/recorder.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "preview": "node docs/preview/render.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^3.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-job-controller"
      ]
    }
  }
}
